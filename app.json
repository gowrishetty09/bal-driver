{
  "expo": {
    "name": "BAL Driver",
    "slug": "bal-driver",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/playstore.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "notification": {
      "icon": "./assets/notifiy-icon.png",
      "color": "#151e2d"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "jsEngine": "jsc",
      "bundleIdentifier": "com.bal.driver",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BAL Driver uses your location to show nearby and assigned rides while you use the app.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "BAL Driver uses your location during active rides so dispatch, hotels, and admins can track the assigned car even when navigation is open.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "runtimeVersion": "1.1.0",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/8438fa17-4c08-44c3-ac11-2962a3c04b1b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "package": "com.bal.driver",
      "versionCode": 22,
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcons/playstore.png",
        "backgroundColor": "#151e2d"
      },
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAz4YMeMa3klDCnm_HZh6IuwkqA_5t0I0w"
        }
      },
      "edgeToEdgeEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "BAL Driver uses your location during active rides so dispatch, hotels, and admins can track the assigned car even when navigation is open."
        }
      ],
      "expo-updates",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://bestaerolimo.com/api",
      "useMocks": false,
      "googlePlacesApiKey": "AIzaSyAz4YMeMa3klDCnm_HZh6IuwkqA_5t0I0w",
      "sosContacts": {
        "police": "100",
        "medical": "108",
        "support": "+1800123456",
        "shareTemplate": "Emergency! Please track me at https://maps.google.com/?q={lat},{lng}"
      },
      "eas": {
        "projectId": "8438fa17-4c08-44c3-ac11-2962a3c04b1b"
      }
    },
    "owner": "pranas9s-organization"
  }
}
