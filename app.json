{
  "expo": {
    "name": "BAL Driver",
    "slug": "bal-driver",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/playstore.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bal.driver",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BAL Driver uses your location to show nearby and assigned rides while you use the app.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "BAL Driver shares your location while Ready for rides to match nearby bookings, and during active rides so customers and dispatch can track the car, including with the screen locked or navigation open.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "runtimeVersion": "1.1.1",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/8438fa17-4c08-44c3-ac11-2962a3c04b1b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "package": "com.bal.driver",
      "versionCode": 22,
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcons/playstore.png",
        "backgroundColor": "#151e2d"
      },
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAz4YMeMa3klDCnm_HZh6IuwkqA_5t0I0w"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notifiy-icon.png",
          "color": "#151e2d"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "BAL Driver shares your location while Ready for rides to match nearby bookings, and during active rides so customers and dispatch can track the car, including with the screen locked or navigation open."
        }
      ],
      "expo-updates",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "https://bestaerolimo.com/api",
      "useMocks": false,
      "googlePlacesApiKey": "AIzaSyAz4YMeMa3klDCnm_HZh6IuwkqA_5t0I0w",
      "sosContacts": {
        "police": "999",
        "medical": "999",
        "support": "+60192667788",
        "shareTemplate": "Emergency! Please track me at https://maps.google.com/?q={lat},{lng}"
